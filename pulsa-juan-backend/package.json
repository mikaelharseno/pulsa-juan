{
  "name": "pulsa-juan-backend",
  "version": "0.1.0",
  "private": true,
  "description": "pulsa-juan API: agent app + admin dashboard backend (Express, Prisma, Postgres)",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "ts-node src/server.ts",
    "start:prod": "node ./dist/src/server.js",
    "dev": "nodemon",
    "build": "tsc && node scripts/copy-prisma-client.js",
    "test": "jest --runInBand --detectOpenHandles",
    "lint": "eslint .",
    "database": "prisma studio",
    "migrate:dev": "prisma migrate dev",
    "migrate:prod": "npx -y dotenv-cli -e .env.production -- prisma migrate deploy",
    "seed": "prisma db seed",
    "seed:bills:prod": "npx -y dotenv-cli -e .env.production -- ts-node prisma/seed.ts --bills-only",
    "pretest": "bash scripts/test-db.sh"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.1",
    "google-auth-library": "^9.14.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pulsa-juan-common": "*",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-fileupload": "^1.5.0",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "fflate": "0.8.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prisma": "^5.21.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
