PORT=3030
NODE_ENV=local

# Postgres (DIRECT_URL is used by prisma migrate; DATABASE_URL may be pooled)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pulsa_juan"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pulsa_juan"

# JWT signing secret (admin + agent tokens). Rotate before deploying.
TOKEN_SECRET=change-me-dev-only

# Seeded first admin (OWNER role)
ADMIN_EMAIL=admin@pulsajuan.local
ADMIN_PASSWORD=admin123

# Google Sign-In (agent app). Both ids are accepted audiences.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Uploads: local (default) or s3
UPLOAD_DRIVER=local
UPLOADS_DIR=
UPLOADS_PUBLIC_BASE=http://localhost:3030
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_ENDPOINT=
S3_REGION=
S3_KEY_PREFIX=
S3_ACL=

# v1 fulfilment stub: set to 1 to let BillInquiry return a fake bill
FULFILLMENT_STUB=0
# shared secret for POST /api/fulfillment/callback/:provider (header X-Callback-Secret); unset = disabled
FULFILLMENT_CALLBACK_SECRET=

# OtomaX H2H (our own OtomaX center). All four set = packages with an OtomaX product code
# (Package.supplierSku) are fulfilled automatically; otherwise everything stays manual.
OTOMAX_URL=
OTOMAX_MEMBER_ID=
OTOMAX_PIN=
OTOMAX_PASSWORD=
# sign (default: sha1 signature instead of pin/password in the URL) | plain
OTOMAX_AUTH=sign
OTOMAX_TIMEOUT_MS=15000
# secret in the report URL set in OtomaX: <api>/api/fulfillment/otomax/report?key=<OTOMAX_REPORT_KEY>
OTOMAX_REPORT_KEY=
# optional comma-separated IPs allowed to call the report URL
OTOMAX_REPORT_IPS=
# optional regex overrides for the center's message wording (case-insensitive; SN needs one capture group)
OTOMAX_SUCCESS_RE=
OTOMAX_FAIL_RE=
OTOMAX_SN_RE=
# refID prefix of bill checks (orders use the bare order number). If the center only
# accepts numeric refIDs, use a long numeric prefix that order numbers never reach, e.g. 9000000
OTOMAX_CHECK_REF_PREFIX=C

# Telegram admin alerts (top-up claimed, order needs action, stuck orders). Unset = off.
TELEGRAM_BOT_TOKEN=
# comma-separated chat ids (a group id looks like -100...)
TELEGRAM_ALERT_CHAT_IDS=
# dashboard base URL for links in alerts
DASHBOARD_URL=
ALERT_PENDING_MINUTES=10

# OTP: codes are only logged until a WhatsApp/SMS gateway is wired. 1 = also return
# the code in the /auth/otp/request response (dev/test only, NEVER in production)
OTP_DEBUG=0
