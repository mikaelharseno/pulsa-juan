{
  "expo": {
    "name": "Murah Kuota",
    "slug": "pulsa-juan",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "murahkuota",
      "com.murahkuota.agent"
    ],
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.murahkuota.agent",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#1E9C8F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1E9C8F"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Murah Kuota memakai kamera untuk memotret KTP dan cek wajah saat verifikasi identitas.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Murah Kuota memakai lokasi untuk mengisi daerah domisili saat mendaftar."
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBase": "http://localhost:3030/api",
      "googleWebClientId": "",
      "googleAndroidClientId": "",
      "router": {},
      "eas": {
        "projectId": "f936e2e0-f960-4dbe-aced-905f72adcd51"
      }
    },
    "owner": "mikhrs"
  }
}
