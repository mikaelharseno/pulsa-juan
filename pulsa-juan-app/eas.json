{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_MOCK": "1"
      },
      "node": "20.19.4"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "node": "20.19.4"
    },
    "release-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://pulsajuan.studiosclo.uk/api"
      },
      "node": "20.19.4"
    }
  }
}
